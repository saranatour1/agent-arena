    "@convex-dev/static-hosting": "^0.2.1",
    "@convex-dev/workflow": "^0.4.10",
    "@fontsource-variable/saira": "^5.3.0",
    "@typesafe-ai/sdk": "^0.7.0",
    "ai": "^7.0.163",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "convex": "^1.49.0",
    "convex-helpers": "^0.1.134",
